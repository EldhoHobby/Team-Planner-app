# Keep the Docker build context small and prevent host artifacts from leaking
# into the image. IMPORTANT: .git is intentionally NOT ignored — the builder
# stage runs `git rev-parse --short HEAD` to stamp the version string.

node_modules
.next
out
build

# secrets & local env — at ANY depth (e.g. "USB Files/.../.env")
.env
.env*.local
**/.env
**/.env*.local

# machine-move bundles and DB dumps — contain credentials + customer data
USB Files
**/*.dump
**/*.dump.part

# image bundles / notes / misc
*.tar
*.tar.gz
backups
backups/
process.txt
npm-debug.log*
*.tsbuildinfo
.DS_Store
