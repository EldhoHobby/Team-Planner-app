# ─── Copy to .env and fill in. Never commit .env. ───
#DreamsLIVE Solutions

# Postgres (used by the db container and the app's DATABASE_URL)
DB_PASSWORD=change-me-strong-password
# Inside Compose the host is the service name "db". For local non-Docker dev use localhost.
DATABASE_URL=postgres://planner:change-me-strong-password@db:5432/planner

# Public URL the app is served at (used for building set-password links).
# Production: https://10.210.6.233:8443
APP_URL=https://planner.localhost

# This host's LAN IP. The Caddyfile reads it (default_sni + the site address),
# so the Caddyfile itself never needs a per-host edit. Unset = 127.0.0.1 only
# (planner.localhost still works on this machine). After changing it:
# `docker compose up -d proxy` (add -f docker-compose.offline.yml on production).
# Dev PC: 10.210.4.130   Production: 10.210.6.233
LAN_IP=

# docker-compose.offline.yml only: host port for HTTPS (default 8443, because
# Windows often reserves 443). docker-compose.yml always publishes 80 + 443.
#HTTPS_PORT=8443

# (Unused settings that may linger in an old .env and are ignored:
#  SESSION_SECRET, SMTP_URL, SMTP_FROM, MAX_UPLOAD_MB, SEED_DEFAULT_TECHNICIANS,
#  APP_DOMAIN. Sessions are random tokens stored as SHA-256 hashes — nothing is
#  signed — and password links are handed over by an admin, not emailed.)

# Days to keep the admin activity/audit log (Settings → Audit). Older entries
# are pruned daily. Whole days, 1–36500; default 30. Field-level change history
# (who changed which value from what to what) is kept PERMANENTLY regardless.
AUDIT_RETENTION_DAYS=30

# Path (inside the container) to the QEI timesheet Excel template used when
# generating timesheets. The compose files bind-mount a host folder here so you
# can update the template without rebuilding. Default (baked into the image):
TIMESHEET_TEMPLATE_PATH=/app/timesheet-template/Time_Sheet_Template.xlsm

# ─── Optional: Email → task ingest (monitors a Gmail inbox over IMAP) ───
# Send/Bcc an email to this mailbox with "@username" tags (or "@Full Name") in
# the subject/body to create dashboard tasks for those people (no tag → assigned
# to the sender, if their From address matches a user). Requires outbound
# internet from the host. Only ONE install may poll a given inbox.
# Gmail setup: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and put it in IMAP_PASSWORD.
EMAIL_INGEST_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_SECONDS=120

# ─── Optional: local AI email assist (Ollama — no cloud, no cost) ───
# When enabled, ingest asks a local model for the email's target date and
# priority (the task title is always the email subject). On any failure the
# task is simply created without them. The "ollama" containers only start with
# the compose profile "ai":
#   docker compose --profile ai up -d
# The first start with this enabled downloads the model (~2 GB) once into the
# ollama_models volume. qwen2.5:3b-instruct needs ~4 GB free RAM while working
# (CPU is fine). Small hosts: llama3.2:1b. NVIDIA GPU: qwen2.5:7b-instruct.
EMAIL_AI_ENABLED=false
EMAIL_AI_MODEL=qwen2.5:3b-instruct
OLLAMA_URL=http://ollama:11434

# ─── Automatic nightly database backups ───
# The backup sidecar dumps the database to ./backups once at startup and then
# every 24 hours, deleting daily dumps older than this many days (only after a
# successful dump, and never the newest 3).
BACKUP_KEEP_DAYS=14
# It also keeps the month's first good dump as planner-monthly-YYYYMM.dump and
# deletes those monthly copies after this many days (400 ≈ 13 months).
BACKUP_KEEP_MONTHLY_DAYS=400
