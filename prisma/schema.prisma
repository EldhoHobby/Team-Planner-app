// Team Planner — data model
// Tenancy rule: every domain row carries orgId; team-scoped rows also carry teamId.
// All access goes through the scoped helpers in src/lib/db — never query unscoped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & tenancy ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  teams       Team[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
  events      CalendarEvent[]
  timeOff     TimeOff[]
  attachments Attachment[]
  techTimeOff TechnicianTimeOff[]
  holidays    Holiday[]
  auditLogs   AuditLog[]
  emailLogs   EmailIngestLog[]
  timesheets  Timesheet[]
  techTasks   TechTask[]
  managerLinks ManagerLink[]
  workGroups   WorkGroup[]
  techTaskNotes TechTaskNote[]
  jobNotes      JobNote[]
  changeHistory ChangeHistory[]
  saCustomers   SaCustomer[]
  saPrices      SaPrice[]
  saCalls       SaCallsRepairs[]
  saSettings    SaSettings?
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // primary login key (lowercase; ^[a-z0-9._-]{3,32}$)
  email        String?  @unique // optional contact address (Postgres allows many NULLs)
  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  theme        String? // "light" | "dark" — per-user UI theme (null = follow system)
  empNo        String? // employment ID, shown on the timesheet (Emp No #)
  // ── Scheduling attributes (a person IS a technician — one unified record) ──
  color        String   @default("#64748b") // colour on the schedule board
  schedulable  Boolean  @default(true) // appears on the board / can be assigned jobs
  archived     Boolean  @default(false) // soft-delete: hidden everywhere, history kept
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  teamMemberships TeamMembership[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  taskAssignments TaskAssignment[]
  timeOff         TimeOff[]
  uploads         Attachment[]
  invitesSent     Invitation[]         @relation("InvitedBy")
  jobs            Task[]               @relation("JobAssignee")
  timeOffBlocks   TechnicianTimeOff[]
  timesheets      Timesheet[]
  techTasks       TechTask[]
  managedLinks    ManagerLink[]        @relation("MgrLinkManager")
  managerLinks    ManagerLink[]        @relation("MgrLinkMember")
  workGroups      WorkGroupMembership[]
  actingSessions  Session[]            @relation("SessionActingAs")
}

// Extra reporting lines beyond a person's home department — for the few people
// who also answer to a manager elsewhere. Department managers already see their
// whole department; this covers the exceptions. (member is seen by manager.)
model ManagerLink {
  id        String   @id @default(cuid())
  orgId     String
  managerId String
  memberId  String
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager User         @relation("MgrLinkManager", fields: [managerId], references: [id], onDelete: Cascade)
  member  User         @relation("MgrLinkMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([managerId, memberId])
  @@index([orgId, memberId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// User's membership in an organization.
model Membership {
  id     String  @id @default(cuid())
  role   OrgRole @default(MEMBER)
  userId String
  orgId  String

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Team {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  parentTeamId String? // null = top-level department; set = sub-team (e.g. System Eng under Engineering)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent      Team?            @relation("TeamTree", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children    Team[]           @relation("TeamTree")
  members     TeamMembership[]
  projects    Project[]
  events      CalendarEvent[]
  timeOff     TimeOff[]
  invitations Invitation[]

  @@unique([orgId, name])
  @@index([orgId, parentTeamId])
}

// ── Cross-functional pools (Field Service, Production Release, ...) ──
// Departments (Team) are the reporting/tenancy structure; WorkGroups are the
// scheduling/assignment structure and cut across the department tree.
enum WorkGroupPurpose {
  FIELD_SERVICE
  PRODUCTION_RELEASE
  OTHER
}

enum WorkGroupRole {
  COORDINATOR // oversight (e.g. the System Eng Project Manager on Production Release)
  MEMBER
}

model WorkGroup {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  purpose   WorkGroupPurpose @default(FIELD_SERVICE)
  archived  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  org     Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members WorkGroupMembership[]
  tasks   Task[]

  @@unique([orgId, name])
  @@index([orgId])
}

model WorkGroupMembership {
  id          String        @id @default(cuid())
  workGroupId String
  userId      String
  role        WorkGroupRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workGroupId, userId])
  @@index([userId])
}

enum TeamRole {
  MANAGER
  MEMBER
}

model TeamMembership {
  id     String   @id @default(cuid())
  role   TeamRole @default(MEMBER)
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// ─────────────────────────── Auth tokens & sessions ───────────────────────────

// Server-side sessions so we can revoke. The cookie holds a random token;
// only its SHA-256 hash is stored here, so a DB leak can't be used to log in.
model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  // "View as" (OWNER-only testing tool): when set, the app renders and acts as
  // this user while audit logs still record the real session owner.
  actingAsUserId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actingAs User? @relation("SessionActingAs", fields: [actingAsUserId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Single-use, time-boxed. issuedByUserId set when an admin generates the link.
model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  issuedByUserId String? // null = self-service; set = admin-issued
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Invite-only registration. Org-scoped; optional team for direct team placement.
model Invitation {
  id              String       @id @default(cuid())
  orgId           String
  teamId          String?
  email           String
  orgRole         OrgRole      @default(MEMBER)
  teamRole        TeamRole?
  tokenHash       String       @unique
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  createdAt       DateTime     @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy User         @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([orgId])
  @@index([email])
}

// ─────────────────────────── Projects, boards, tasks ───────────────────────────

model Project {
  id          String   @id @default(cuid())
  orgId       String
  teamId      String
  name        String
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team   Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  boards Board[]
  tasks  Task[]

  @@index([orgId, teamId])
}

model Board {
  id        String   @id @default(cuid())
  projectId String
  name      String   @default("Board")
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@index([projectId])
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int    @default(0)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Distinguishes a generic task from a field-service job. FIELD_SERVICE tasks use
// the job* fields + technician/start/end below and appear on the schedule board.
enum TaskKind {
  GENERAL
  FIELD_SERVICE
}

enum JobType {
  COMMISSIONING
  TRAINING
  ANNUAL_MAINTENANCE
  EMERGENCY_SUPPORT
}

// Where a task came from: created by the person (SELF), assigned to them by
// someone else (MANAGER), or synced in from Outlook (OUTLOOK).
enum TaskOrigin {
  SELF
  MANAGER
  OUTLOOK
}

// Field-service lifecycle, distinct from the generic TaskStatus.
enum JobStatus {
  UNCONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// Person unavailability (PTO, training, sick) — blocks scheduling on the board.
// `technicianId` now holds a User id (a person IS a technician). Column name kept
// so the schedule board + Jobs round-trip stay unchanged.
model TechnicianTimeOff {
  id           String   @id @default(cuid())
  orgId        String
  technicianId String // → User.id (the person who's off)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  technician User         @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, startDate])
  @@index([orgId])
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  teamId      String
  projectId   String
  columnId    String?
  kind        TaskKind     @default(GENERAL)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  estimateHrs Float? // used for derived capacity calculations
  position    Int          @default(0) // ordering within a column
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── Field-service (kind = FIELD_SERVICE) ──
  soNumber       String?
  customerName   String?
  jobType        JobType?
  jobStatus      JobStatus? @default(UNCONFIRMED)
  hardwareTarget String?
  startDate      DateTime? // null → sits in the unscheduled backlog
  endDate        DateTime?
  durationDays   Int?
  tentative      Boolean    @default(false) // pencilled-in date → hatched on the board
  technicianId   String?
  workGroupId    String? // which cross-functional pool the job draws from (null = org-wide)

  // ── Task list (personal / assigned tasks; kind = GENERAL) ──
  origin         TaskOrigin @default(SELF)
  isFieldTrip    Boolean    @default(false)
  location       String?
  assignedById   String? // who assigned it (set for MANAGER origin)
  // Two-way sync scaffolding for a future Outlook / Microsoft Graph connector.
  // Populated when a connector is wired; syncDirty flags a local completion change
  // that still needs to be pushed back to the source system.
  externalId     String? // id in the source system (Outlook)
  externalSource String? // "outlook_todo" | "outlook_event"
  externalUrl    String?
  lastSyncedAt   DateTime?
  syncDirty      Boolean    @default(false)

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      BoardColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull)
  technician  User?            @relation("JobAssignee", fields: [technicianId], references: [id], onDelete: SetNull)
  workGroup   WorkGroup?       @relation(fields: [workGroupId], references: [id], onDelete: SetNull)
  assignments TaskAssignment[]
  attachments Attachment[]
  jobNotes    JobNote[] // field-service job comment thread (reason-for-change etc.)

  @@index([orgId, teamId, status])
  @@index([projectId, columnId, position])
  @@index([dueDate])
  @@index([orgId, kind, startDate])
  @@index([technicianId, startDate])
  @@index([orgId, externalSource, externalId])
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ─────────────────────────── Calendar & time-off ───────────────────────────

enum EventType {
  EVENT
  MEETING
  MILESTONE
}

model CalendarEvent {
  id        String    @id @default(cuid())
  orgId     String
  teamId    String
  title     String
  type      EventType @default(EVENT)
  startsAt  DateTime
  endsAt    DateTime
  allDay    Boolean   @default(false)
  createdAt DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startsAt])
}

enum TimeOffType {
  PTO
  SICK
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeOff {
  id        String        @id @default(cuid())
  orgId     String
  teamId    String
  userId    String
  type      TimeOffType   @default(PTO)
  status    TimeOffStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([teamId, status])
}

// ─────────────────────────── Attachments ───────────────────────────

// Company/public holidays — surfaced on the calendar; scheduling on one warns.
model Holiday {
  id        String   @id @default(cuid())
  orgId     String
  date      DateTime
  name      String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date])
  @@index([orgId])
}

// ─────────────────────────── Timesheets ───────────────────────────

// A weekly timesheet for one user (week ends on a Saturday — matches the QEI
// template). Filled in the app, stored here, and rendered into the Excel
// template on generate. One per user per week.
model Timesheet {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  weekEnding DateTime // the Saturday the week ends on (UTC midnight)
  comments   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TimesheetEntry[]

  @@unique([userId, weekEnding])
  @@index([orgId])
}

enum TimesheetSection {
  DIRECT
  INDIRECT
}

// One row of a timesheet. DIRECT rows use so/customer/issue/workDept; INDIRECT
// rows use functionLabel (one of the fixed template categories). Hours are per
// day, Sunday..Saturday.
model TimesheetEntry {
  id            String           @id @default(cuid())
  timesheetId   String
  section       TimesheetSection
  lineNo        Int
  // DIRECT columns
  workDept      String?
  soNumber      String?
  customerName  String?
  issueNo       String?
  // INDIRECT column
  functionLabel String?
  // hours per day
  sun           Float            @default(0)
  mon           Float            @default(0)
  tue           Float            @default(0)
  wed           Float            @default(0)
  thu           Float            @default(0)
  fri           Float            @default(0)
  sat           Float            @default(0)

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
}

// ─────────────────────────── Tech task dashboard ───────────────────────────

// Workflow state for a personal/tech task (matches the QEI open-items sheet).
enum TechTaskState {
  NEW
  TODO
  IN_PROGRESS
  HOLD
  DONE
}

// A single open-items entry owned by one person (the technician). A manager can
// create tasks for their direct reports; the person can create their own; a
// future Outlook connector fills OUTLOOK-origin ones. Shown on /dashboard.
model TechTask {
  id           String        @id @default(cuid())
  orgId        String
  ownerId      String // the person this task belongs to
  createdById  String? // who created it
  assignedById String? // who assigned it (set for MANAGER origin)
  title        String
  notes        String?
  priority     Int           @default(3) // 1 = highest, like the sheet
  targetDate   DateTime? // targeted complete date (null = TBD)
  state        TechTaskState @default(NEW)
  completedAt  DateTime? // when it moved to DONE (drives week-by-week grouping)
  origin       TaskOrigin    @default(SELF)
  location     String?
  // Two-way sync scaffolding for a future Outlook / Microsoft Graph connector.
  externalId     String?
  externalSource String? // "outlook_todo" | "outlook_event"
  externalUrl    String?
  lastSyncedAt   DateTime?
  syncDirty      Boolean     @default(false)
  // Optimistic-locking counter (template for new modules — see
  // src/lib/db/optimistic.ts). Every update bumps it; a save that names a
  // stale version is rejected with StaleSaveError instead of overwriting.
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner  User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  thread TechTaskNote[] // ticket comments + change notes ("notes" scalar = details text)

  @@index([orgId, ownerId, state])
  @@index([orgId, externalSource, externalId])
  // Dedupe backstop for email ingest (and future sync connectors): one task per
  // person per external item, enforced even across concurrent ingest passes.
  // Rows with NULL externalId are exempt (Postgres treats NULLs as distinct).
  @@unique([orgId, ownerId, externalSource, externalId])
}

// GitLab-style ticket thread on a dashboard task: user COMMENTs and system
// CHANGE notes (who changed what, when) interleaved chronologically. Kept
// forever (not pruned like AuditLog). authorId is a plain string — no FK — so
// the thread survives user deletion and full-backup machine moves.
enum NoteKind {
  COMMENT
  CHANGE
}

model TechTaskNote {
  id         String    @id @default(cuid())
  orgId      String
  taskId     String
  authorId   String?
  authorName String // display name snapshot at write time
  kind       NoteKind
  body       String // comment text, or e.g. "state: To Do → In Progress"
  editedAt   DateTime? // set when a comment is edited ("(edited)" marker)
  createdAt  DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task TechTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([orgId])
}

// Comment thread on a field-service job (the "reason for the change" and any
// discussion). Comments only; the change history itself lives in AuditLog and is
// merged in at display time. Included in the full backup; NOT in the Excel
// round-trip. Never pruned.
model JobNote {
  id         String    @id @default(cuid())
  orgId      String
  jobId      String
  authorId   String?
  authorName String // display-name snapshot at write time
  body       String
  editedAt   DateTime? // set when a comment is edited ("(edited)" marker)
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job Task         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([orgId])
}

// One row per email seen by the ingest poller — feeds the Settings → Email
// statistics. Retention: rows older than 30 days are pruned on each pass.
enum EmailIngestOutcome {
  CREATED // one or more tasks were created
  SKIPPED // no tag + unknown sender, or already imported
  ERROR   // message could not be processed
}

model EmailIngestLog {
  id         String             @id @default(cuid())
  orgId      String
  occurredAt DateTime           @default(now())
  messageId  String? // RFC Message-ID (dedupe reference)
  fromAddr   String?
  subject    String?
  outcome    EmailIngestOutcome
  detail     String? // e.g. "task for Charles Fry", or the skip/error reason
  taskCount  Int                @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
}

// Change-history trail for jobs, technicians, etc. (what / when / who).
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  actorEmail String?
  entity     String // "job" | "technician" | "timeoff" | ...
  entityId   String
  action     String // "created" | "updated" | "rescheduled" | "deleted" | ...
  summary    String // human-readable description of the change
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entity, entityId])
  @@index([orgId, createdAt]) // audit page: newest-first browsing + retention prune
}

// PERMANENT field-level change history (who / when / entity / field / old → new).
// Unlike AuditLog this is NEVER pruned — it is the record of truth for things
// like agreement-price changes. Written via recordFieldChanges() in
// src/lib/services/change-history.ts, ideally in the SAME transaction as the
// update. actorId is a plain string (no FK) so history survives user deletion;
// actorName is a display-name snapshot. Values are stored as text (null = empty).
model ChangeHistory {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String? // REAL user (an OWNER using "View as" is recorded as themselves)
  actorName String
  entity    String // "techtask" | "agreement" | ...
  entityId  String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entity, entityId, createdAt])
  @@index([orgId, createdAt])
}

// Metadata in Postgres; bytes on the local uploads volume. Downloads are
// served through the app so RBAC/tenancy is enforced.
model Attachment {
  id           String   @id @default(cuid())
  orgId        String
  taskId       String
  filename     String
  contentType  String
  sizeBytes    Int
  storagePath  String // path within the uploads volume
  uploadedById String
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([orgId])
}

// ─── Service agreements (/agreements) ────────────────────────────────────────
// Customers keyed by their SERVICE SO # (the first system's sales order —
// NOT Task.soNumber, which is a project SYS#). Prices are one row per
// customer + year + agreement; the Customer View, Renewals list, proposals and
// reports all read from these tables. Every edit is version-guarded
// (src/lib/db/optimistic.ts) and price/status changes go to ChangeHistory
// (entity "sa_customer", entityId = customer id) so history survives row deletes.

enum SaCustomerStatus {
  ACTIVE
  NOT_RENEWED
  INACTIVE
}

enum SaSoftware {
  QSCADA_PLUS
  TDMS
  RTU_ONLY
}

// Fixed display order on every screen (see SA_AGREEMENTS in src/lib/agreements).
enum SaAgreement {
  SCADA_SOFTWARE
  CONFIGWIZ
  RTU_HARDWARE
  SERVER_HARDWARE
  AFTER_HOURS
  ONSITE
  DIAGNOSTIC
  BACKUP_DR
  WEB_TRAINING
  NERC_RIDER
  QWEB
  OTHER
}

enum SaPriceStatus {
  SIGNED
  PROPOSED
  CANCELLED
}

enum SaTdmsMode {
  EVERY_YEAR // multiply on every renewal (policy Rev 062426)
  TIERS // the doubling is done; escalate by the normal tiers
}

model SaCustomer {
  id              String           @id @default(cuid())
  orgId           String
  soNumber        String // first system's sales order — unique per org, required
  name            String
  status          SaCustomerStatus @default(ACTIVE)
  state           String?
  software        SaSoftware?
  softwareVersion String?
  wvPeVersion     String?
  server          String?
  serverInstall   String? // free text in the source data ("2020-09-01", "Unknown", …)
  lastServerSo    String?
  qwebLicenses    Int?
  notes           String?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prices SaPrice[]
  calls  SaCallsRepairs[]

  @@unique([orgId, soNumber])
  @@index([orgId, name])
}

model SaPrice {
  id           String        @id @default(cuid())
  orgId        String
  customerId   String
  year         Int
  agreement    SaAgreement
  price        Decimal       @db.Decimal(12, 2)
  status       SaPriceStatus @default(PROPOSED)
  endDate      DateTime?     @db.Date
  signedDate   DateTime?     @db.Date
  createdDate  DateTime?     @db.Date // stamped when a proposal is created/adjusted
  checked      Boolean       @default(false) // Maintenance report "Checked"
  dateInvoiced DateTime?     @db.Date // Maintenance report "DATE INV'D"
  notes        String?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer SaCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // One row per customer + year + agreement: adding can never overwrite.
  @@unique([customerId, year, agreement])
  @@index([orgId, year])
  @@index([orgId, endDate])
}

model SaCallsRepairs {
  id         String   @id @default(cuid())
  orgId      String
  customerId String
  year       Int
  calls      Int      @default(0)
  repairs    Int      @default(0)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer SaCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, year])
  @@index([orgId])
}

// Pricing rules used by New Proposal / bulk proposals (one row per org).
// Defaults = 2026 Technical Services Policy Pricing (Rev 062426).
model SaSettings {
  orgId             String        @id
  tierLowMax        Int           @default(5000) // ≤ this → pctLow
  tierMidMax        Int           @default(10000) // ≤ this → pctMid, above → pctHigh
  pctLow            Decimal       @default(5) @db.Decimal(5, 2)
  pctMid            Decimal       @default(4) @db.Decimal(5, 2)
  pctHigh           Decimal       @default(3) @db.Decimal(5, 2)
  tdmsMultiplier    Decimal       @default(2) @db.Decimal(6, 3)
  tdmsMode          SaTdmsMode    @default(EVERY_YEAR)
  escalating        SaAgreement[] @default([SCADA_SOFTWARE, CONFIGWIZ, RTU_HARDWARE, SERVER_HARDWARE, QWEB])
  autoWaiveAfterHours Boolean     @default(true)
  afterHoursWaiveAt Int           @default(25000) // SCADA Software ≥ this → After Hours $0
  // Standard prices entered by the manager for NEW proposals (whole dollars).
  // Blank (null) = keep the customer's last signed price for that agreement.
  priceAfterHours   Int?
  priceDiagnostic   Int?
  priceBackupDr     Int?
  priceWebTraining  Int?
  priceNercRider    Int?
  version           Int           @default(1)
  updatedAt         DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
