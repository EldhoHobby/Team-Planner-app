# dependencies
/node_modules

# next.js
/.next
/out

# production
/build

# env & secrets
.env
.env*.local

# prisma
/prisma/*.db

# local uploads (dev only; in prod this is a Docker volume)
/uploads

# database backups (host folder written by the backup sidecar + status/log
# files). Keep only the placeholder that makes the folder exist in a clone.
/backups/*
!/backups/.gitkeep
# DB dumps anywhere (customer data + password hashes) - never commit
*.dump
*.dump.part

# machine-move / USB deploy folder (may hold .env copies and dumps)
/USB Files/

# misc
.DS_Store
*.pem
npm-debug.log*
*.tsbuildinfo
next-env.d.ts

# local agent / tooling cache (not part of the app)
/.claude

# docker image bundles / model exports for offline deploy (large; never commit)
*.tar
*.tar.gz
*.tgz

# scratch/notes, test coverage, logs
process.txt
/coverage
*.log
*.zip
